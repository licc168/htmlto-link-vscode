{
  "name": "htmlto-link-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "version": "0.1.20",
  "license": "MIT",
  "publisher": "licc",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/licc168/htmlto-link-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "html",
    "static site",
    "website",
    "publish",
    "deploy",
    "landing page",
    "frontend demo",
    "share",
    "preview",
    "htmlto.link",
    "html deploy",
    "static deploy",
    "静态部署",
    "静态网站",
    "静态站",
    "一键发布",
    "网页部署",
    "HTML部署",
    "HTML发布",
    "网站发布",
    "前端预览",
    "前端演示",
    "落地页发布"
  ],
  "activationEvents": [
    "onCommand:htmlToLink.openPanel",
    "onCommand:htmlToLink.deployFolder",
    "onCommand:htmlToLink.quickPublish",
    "onCommand:htmlToLink.setToken",
    "onCommand:htmlToLink.clearToken",
    "onCommand:htmlToLink.openLastDeployUrl",
    "onView:htmlToLink.sidebarView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlToLink.openPanel",
        "category": "%commandCategory%",
        "title": "%command.openPanel.title%",
        "icon": "$(rocket)"
      },
      {
        "command": "htmlToLink.deployFolder",
        "category": "%commandCategory%",
        "title": "%command.deployFolder.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "htmlToLink.quickPublish",
        "category": "%commandCategory%",
        "title": "%command.quickPublish.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "htmlToLink.setToken",
        "category": "%commandCategory%",
        "title": "%command.setToken.title%",
        "icon": "$(key)"
      },
      {
        "command": "htmlToLink.clearToken",
        "category": "%commandCategory%",
        "title": "%command.clearToken.title%",
        "icon": "$(trash)"
      },
      {
        "command": "htmlToLink.openLastDeployUrl",
        "category": "%commandCategory%",
        "title": "%command.openLastDeployUrl.title%",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "htmlToLink",
          "title": "%viewContainer.title%",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "htmlToLink": [
        {
          "id": "htmlToLink.sidebarView",
          "name": "%view.sidebar.name%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "htmlToLink.quickPublish",
          "when": "resourceLangId == html",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "htmlToLink.quickPublish",
          "when": "resourceLangId == html",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "htmlToLink.openPanel",
          "when": "view == htmlToLink.sidebarView",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "htmlToLink.quickPublish",
          "when": "resourceExtname == .html",
          "group": "navigation@89"
        },
        {
          "command": "htmlToLink.deployFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "htmlToLink.apiBaseUrl": {
          "type": "string",
          "default": "https://htmlto.link",
          "description": "%configuration.apiBaseUrl.description%"
        },
        "htmlToLink.autoCopyUrl": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoCopyUrl.description%"
        },
        "htmlToLink.defaultEntryFile": {
          "type": "string",
          "default": "index.html",
          "description": "%configuration.defaultEntryFile.description%"
        },
        "htmlToLink.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules/**",
            ".git/**",
            ".next/**",
            "dist/cache/**",
            ".turbo/**"
          ],
          "description": "%configuration.excludePatterns.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "check": "tsc -p . --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
